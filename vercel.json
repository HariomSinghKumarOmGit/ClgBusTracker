{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/routes/:id/stops",
      "destination": "/api/stops?routeId=:id"
    },
    {
      "source": "/api/routes/:id",
      "destination": "/api/routes?id=:id"
    },
    {
      "source": "/api/buses/:id",
      "destination": "/api/buses?id=:id"
    },
    {
      "source": "/api/stops/:id",
      "destination": "/api/stops?id=:id"
    },
    {
      "source": "/api/drivers/:id",
      "destination": "/api/drivers?id=:id"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
